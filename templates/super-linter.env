# Reference .github/super-linter.env -- copy to .github/super-linter.env in the
# consuming repository and adjust FILTER_REGEX_EXCLUDE.
#
# The `super-linter` composite action configures NOTHING on its own. It loads this
# file if it exists and otherwise falls through to Super-Linter's defaults, which
# means every linter over the whole codebase. The rw-super-linter.yaml workflow it
# replaces passed these values as workflow inputs instead, so a repository that
# migrates without adding this file gets a wall of findings on generated files.
#
# Super-Linter reads LINTER_RULES_PATH (default `.github/linters`), so the repo's
# own linter configs are honoured without being named here.

# Exclude generated and vendored trees. Extend per repo -- FHIR IGs want
# output/, input-cache/, temp/, template/, fsh-generated/; Node projects want
# node_modules/, dist/, build/, coverage/.
FILTER_REGEX_EXCLUDE=(report/.*|\.vscode/.*|node_modules/.*|dist/.*|build/.*|coverage/.*)
IGNORE_GITIGNORED_FILES=true
LOG_LEVEL=WARN

# true lints the whole codebase; false lints only what the PR changed, matching
# what rw-super-linter.yaml did on pull_request events.
#
# Do NOT add USE_FIND_ALGORITHM alongside VALIDATE_ALL_CODEBASE=false. Super-Linter
# rejects the combination outright -- "Setting USE_FIND_ALGORITHM to true and
# VALIDATE_ALL_CODEBASE to false is not supported" -- because selecting changed
# files is a git operation. Set USE_FIND_ALGORITHM only when linting everything.
VALIDATE_ALL_CODEBASE=false

# The quality-checks job already runs codespell through the shared `spellcheck`
# action, which carries the org word list and the repo's wordsToIgnore.
# Super-Linter's own codespell has neither, so the two disagree -- it flagged
# "iif ==> if" in a repo whose wordsToIgnore is literally "iif". One codespell,
# correctly configured, not two.
VALIDATE_SPELL_CODESPELL=false

# Linters that generate noise on example, generated or third-party code.
# These mirror the set rw-super-linter.yaml disabled.
VALIDATE_BASH=false
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
VALIDATE_EDITORCONFIG=false
VALIDATE_GITHUB_ACTIONS_ZIZMOR=false
VALIDATE_GIT_COMMITLINT=false
VALIDATE_JSCPD=false
VALIDATE_JSON=false
VALIDATE_JSON_PRETTIER=false
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_PYTHON_BLACK=false
VALIDATE_PYTHON_FLAKE8=false
VALIDATE_PYTHON_ISORT=false
VALIDATE_PYTHON_MYPY=false
VALIDATE_PYTHON_RUFF=false
VALIDATE_PYTHON_RUFF_FORMAT=false
VALIDATE_SHELL_SHFMT=false
VALIDATE_TYPESCRIPT_PRETTIER=false
VALIDATE_YAML_PRETTIER=false
