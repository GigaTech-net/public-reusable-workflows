# The trailing `|` before `)` was an empty alternative. A regex SEARCH matches an
# empty pattern at every position, so this excluded EVERY file and Super-Linter
# linted nothing while reporting success. Same defect as Dev-Template's, which is
# where the value was copied from.
FILTER_REGEX_EXCLUDE=(report/.*|\.vscode/.*|node-modules/.*|build/.*|dist/.*|reports/.*|coverage/.*|coverage/.*|node_modules/.*|yarn.lock|src/.*|public/.*|.pa11y.*|.env.*|\.github/.*)
IGNORE_GITIGNORED_FILES=true
LOG_LEVEL=WARN
RUN_LOCAL=true
USE_FIND_ALGORITHM=true
VALIDATE_ALL_CODEBASE=true
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
VALIDATE_GITHUB_ACTIONS_ZIZMOR=false
VALIDATE_GIT_COMMITLINT=false
VALIDATE_PYTHON_RUFF_FORMAT=false
# Spelling is already enforced by the dedicated `spellcheck` composite action,
# which runs codespell with the org's curated --skip/-L lists -- and that --skip
# list names `.gitignore` explicitly. Super-Linter's own codespell is a second,
# differently-configured run of the same tool with neither list, so the two
# disagree. Turning linting on for the first time (see FILTER_REGEX_EXCLUDE
# above) surfaced eight findings, all of them in the vendored GitHub Visual
# Studio .gitignore and all false positives: glob character classes
# ([Rr]elease/ -> "elease", *.[Pp]ublish.xml -> "ublish"), the word "checkin"
# inside prose comments, and Paket, a real .NET package manager. "Correcting"
# the first group would change which paths git ignores.
# One codespell, correctly configured, not two. See templates/super-linter.env.
VALIDATE_SPELL_CODESPELL=false
